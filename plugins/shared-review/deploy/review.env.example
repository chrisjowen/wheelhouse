# The review server's settings, as an env file (docker run --env-file).
# ssh-deploy.sh writes one like this on the host, readable only by its owner,
# with the secrets taken from the vault. Never commit a filled-in copy.

# The address reviewers open (https in production).
REVIEW_PUBLIC_URL=https://review.example.com

# The owner token the review desk on your computer uses (32+ random characters).
# Keep it in wh-vault (SHARED_REVIEW_OWNER_TOKEN); never write it in a file you keep.
REVIEW_OWNER_TOKEN=replace-with-the-owner-token

# Email sign-in (optional): who sign-in links come from, and the SMTP server
# that sends them (a secret; smtps://user:password@smtp.example.com:465).
#REVIEW_EMAIL_FROM=Reviews <reviews@example.com>
#REVIEW_SMTP_URL=smtps://user:password@smtp.example.com:465

# Behind a proxy that sets X-Forwarded-For (Caddy, an ingress): 1.
REVIEW_TRUST_PROXY=1

# Optional: a fixed key for signing sessions; without it one is made and kept in the data folder.
#REVIEW_SESSION_SECRET=
