{
	"name": "@chrisjowen/wheelhouse",
	"version": "0.1.1",
	"description": "Talk to Firstmate and watch its AI crew work: a local web app for chat, live progress, previews and review.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chrisjowen/wheelhouse.git"
	},
	"homepage": "https://github.com/chrisjowen/wheelhouse#readme",
	"bugs": {
		"url": "https://github.com/chrisjowen/wheelhouse/issues"
	},
	"keywords": [
		"firstmate",
		"claude-code",
		"ai-agents",
		"coding-agents",
		"agent-dashboard",
		"developer-tools",
		"cli"
	],
	"type": "module",
	"bin": {
		"wheelhouse": "dist/cli.js",
		"wh-vault": "dist/wh-vault.js"
	},
	"files": [
		"build",
		"dist",
		"plugins",
		"!**/*.map"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run build:cli",
		"build:cli": "esbuild cli/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/cli.js && esbuild cli/vault/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/wh-vault.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "npm run build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.cli.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:smoke",
		"test:unit": "vitest run --project unit --project dom",
		"test:smoke": "npm run build && vitest run --project smoke"
	},
	"dependencies": {
		"commander": "^14.0.0",
		"node-pty": "1.2.0-beta.15",
		"ws": "^8.22.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@lucide/svelte": "^1.55.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.5",
		"@types/ws": "^8.18.2",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.17",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.0.0",
		"happy-dom": "^21.0.4",
		"marked": "^16.4.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^7.3.7",
		"vitest": "^5.0.3"
	}
}
